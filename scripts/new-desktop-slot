#!/usr/bin/env python3
"""Add Desktop <n> to the store as a copy of Desktop 1 (ARCHITECTURE.md, decisions 16 and 17).

Usage: scripts/new-desktop-slot <n>

Slot n gets app id vyrmy-desktop-<n>, Umbrel port 18100 + n, and its own private network,
vyrmy-edge_desk-<n> (10.31.<n>.0/24, Traefik at 10.31.<n>.2), which this adds to Edge's
compose file. Commit both, then follow the steps it prints.
"""

from __future__ import annotations

import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
TEMPLATE = ROOT / "vyrmy-desktop-1"
FILES = ("umbrel-app.yml", "docker-compose.yml")
BASE_PORT = 18100
EDGE_COMPOSE = ROOT / "vyrmy-edge" / "docker-compose.yml"
# The lines in Edge's compose file that each slot's entries go above.
TRAEFIK_MARKER = "      # new-desktop-slot: Traefik desk networks end here.\n"
NETWORKS_MARKER = "  # new-desktop-slot: desk network definitions end here.\n"
# What each template file must contain, so a renamed line fails here instead of leaving
# slot 1's id, port or addresses in the copy.
REQUIRED = {
    "umbrel-app.yml": ("vyrmy-desktop-1", "Desktop 1", f"port: {BASE_PORT + 1}"),
    "docker-compose.yml": ("vyrmy-desktop-1", "Desktop 1", "desk-1", "10.31.1."),
}


def add_edge_network(n: int) -> None:
    """Give Traefik an address on desk-<n> and define the network, unless it already exists."""
    text = EDGE_COMPOSE.read_text()
    if f"\n  desk-{n}:\n" in text:
        return
    for marker in (TRAEFIK_MARKER, NETWORKS_MARKER):
        if text.count(marker) != 1:
            raise SystemExit(f"{marker.strip()!r} must appear once in {EDGE_COMPOSE}")
    traefik = f"      desk-{n}:\n        ipv4_address: 10.31.{n}.2\n"
    network = (
        f"  desk-{n}:\n"
        "    internal: true\n"
        "    driver: bridge\n"
        "    driver_opts:\n"
        '      com.docker.network.bridge.inhibit_ipv4: "true"\n'
        "    ipam:\n"
        "      config:\n"
        f"        - subnet: 10.31.{n}.0/24\n"
    )
    text = text.replace(TRAEFIK_MARKER, traefik + TRAEFIK_MARKER)
    text = text.replace(NETWORKS_MARKER, network + NETWORKS_MARKER)
    EDGE_COMPOSE.write_text(text)


def main(argv: list[str]) -> int:
    if len(argv) != 2 or not argv[1].isdigit() or not 2 <= int(argv[1]) <= 99:
        print(__doc__.strip(), file=sys.stderr)
        print("\nn must be a whole number from 2 to 99.", file=sys.stderr)
        return 2
    n = int(argv[1])
    target = ROOT / f"vyrmy-desktop-{n}"
    if target.exists():
        print(f"{target.name} already exists", file=sys.stderr)
        return 1
    replacements = [
        ("vyrmy-desktop-1", f"vyrmy-desktop-{n}"),
        ("Desktop 1", f"Desktop {n}"),
        (f"port: {BASE_PORT + 1}", f"port: {BASE_PORT + n}"),
        # The slot's private network and its addresses on it: desktop .10, Squid .3,
        # Traefik .2 (decisions 17 and 18).
        ("desk-1", f"desk-{n}"),
        ("10.31.1.", f"10.31.{n}."),
    ]
    texts = {}
    for name in FILES:
        text = (TEMPLATE / name).read_text()
        for old, new in replacements:
            if old not in text and old in REQUIRED[name]:
                raise SystemExit(f"{old!r} not found in {TEMPLATE.name}/{name}")
            text = text.replace(old, new)
        texts[name] = text
    target.mkdir()
    for name, text in texts.items():
        (target / name).write_text(text)
    add_edge_network(n)
    print(f"Created {target.name} on Umbrel port {BASE_PORT + n}, and desk-{n} in Edge's compose.")
    print(
        f"""
Next:
1. Bump Edge's version in vyrmy-edge/umbrel-app.yml. Commit and push, update Edge on the
   Umbrel first (Desktop {n} cannot start until vyrmy-edge_desk-{n} exists), then install
   Desktop {n} and share it with one person only.
2. Add to edge.yaml under apps (pick the hostname):
     vyrmy-desktop-{n}:
       subdomain: desk-<name>
       external: true
       upstream_host: vyrmy-desktop-{n}_desktop_1
       upstream_port: 3000
3. In Authentik, add its forward auth provider and application, bound to that one person
   (docs/architecture/tasks/008-personal-desktops.md, step 4)."""
    )
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
