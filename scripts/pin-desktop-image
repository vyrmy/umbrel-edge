#!/usr/bin/env python3
"""Pin every Desktop app to a new umbrel-desktop image digest and bump its version.

Usage: scripts/pin-desktop-image sha256:<64 hex> [YYYY-MM-DD]

Run by .github/workflows/desktop.yml after each build. Umbrel offers an update only when
`version` in umbrel-app.yml changes, so a new digest also sets the version to the build
date (UTC), with a .2, .3 suffix for later builds on the same day. Apps whose digest is
already current are left alone.
"""

from __future__ import annotations

import re
import sys
from datetime import UTC, date, datetime
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
IMAGE = re.compile(r"(ghcr\.io/vyrmy/umbrel-desktop:main@)(sha256:[0-9a-f]{64})")
VERSION = re.compile(r'^version: "([^"]*)"$', re.MULTILINE)
DIGEST = re.compile(r"sha256:[0-9a-f]{64}")


def next_version(current: str, today: date) -> str:
    stamp = today.strftime("%Y.%m.%d")
    if current == stamp:
        return f"{stamp}.2"
    if current.startswith(f"{stamp}."):
        return f"{stamp}.{int(current.rsplit('.', 1)[1]) + 1}"
    return stamp


def pin(app: Path, digest: str, today: date) -> bool:
    compose = app / "docker-compose.yml"
    manifest = app / "umbrel-app.yml"
    text = compose.read_text()
    found = IMAGE.search(text)
    if found is None:
        raise SystemExit(f"{compose.relative_to(ROOT)} has no umbrel-desktop image line")
    if found.group(2) == digest:
        return False
    compose.write_text(IMAGE.sub(lambda m: m.group(1) + digest, text))
    meta = manifest.read_text()
    current = VERSION.search(meta)
    if current is None:
        raise SystemExit(f"{manifest.relative_to(ROOT)} has no quoted version line")
    version = next_version(current.group(1), today)
    manifest.write_text(VERSION.sub(f'version: "{version}"', meta, count=1))
    print(f"{app.name}: {version}")
    return True


def main(argv: list[str]) -> int:
    if len(argv) not in (2, 3) or not DIGEST.fullmatch(argv[1]):
        print(__doc__.strip(), file=sys.stderr)
        return 2
    today = date.fromisoformat(argv[2]) if len(argv) == 3 else datetime.now(UTC).date()
    apps = sorted(p for p in ROOT.glob("vyrmy-desktop-*") if p.is_dir())
    if not apps:
        raise SystemExit("no vyrmy-desktop-* folders found")
    changed = [app for app in apps if pin(app, argv[1], today)]
    if not changed:
        print("every Desktop app already uses", argv[1])
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
