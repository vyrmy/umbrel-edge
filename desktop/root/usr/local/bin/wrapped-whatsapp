#!/bin/bash

# WhatsApp has no Linux app, so WhatsApp Web runs in its own Chromium app window. It uses
# the desktop's Chromium profile, so it stays linked across restarts like the browser.
#
# At login the browser starts at the same moment. Webtop's wrapped-chromium clears
# Chromium's singleton lock whenever no Chromium is running, so two simultaneous starts
# can each clear it and fight over the profile. With --after-browser this waits (up to
# 30 seconds) for the browser's singleton socket, then joins that browser as a new window.
# The socket survives a container restart (it lives in /config and points into /tmp), so
# it counts only once a Chromium process is running as well.
if [ "$1" = "--after-browser" ]; then
  shift
  for _ in $(seq 1 30); do
    [ -S "$HOME/.config/chromium/SingletonSocket" ] && pgrep -x chromium > /dev/null && break
    sleep 1
  done
fi

exec /usr/local/bin/wrapped-chromium --app=https://web.whatsapp.com/ "$@"
